# Forge control-plane API production environment (set as Render service env vars,
# not committed). See DEPLOYMENT.md.

# Non-production env so shared-secret (hmac) auth is permitted for the demo.
# A real production deployment would set FORGE_ENV=production and use JWKS/OIDC.
FORGE_ENV=staging

# Shared-secret auth between the portal (which mints tokens) and the API.
FORGE_AUTH_MODE=hmac
# Generate once and set the SAME value on the portal (Vercel):
#   openssl rand -base64 48
FORGE_AUTH_HMAC_SECRET=<strong-random-secret>

# Neon pooled connection string (Dashboard -> Connection Details -> Pooled).
# Must include sslmode=require.
FORGE_DB_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/forge?sslmode=require

# Conservative pool for the free tier.
FORGE_DB_MAX_CONNS=8
FORGE_RATE_LIMIT_RPS=50
FORGE_RATE_LIMIT_BURST=100

# The API binds to the platform-provided PORT automatically; no need to set
# FORGE_HTTP_ADDR on Render.
