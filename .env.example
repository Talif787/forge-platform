FORGE_ENV=development
FORGE_HTTP_ADDR=:8080
FORGE_SHUTDOWN_TIMEOUT=15s

FORGE_DB_URL=postgres://forge:forge@localhost:5432/forge?sslmode=disable
FORGE_DB_MAX_CONNS=10
FORGE_DB_MIN_CONNS=2
FORGE_DB_MAX_CONN_LIFETIME=1h
FORGE_DB_MAX_CONN_IDLE_TIME=30m

# auth: "hmac" for local/dev, "jwks" for OIDC (Okta) in real environments
FORGE_AUTH_MODE=hmac
FORGE_AUTH_HMAC_SECRET=local-development-secret-change-me
FORGE_AUTH_JWKS_URL=
FORGE_AUTH_ISSUER=https://example.okta.com/oauth2/default
FORGE_AUTH_AUDIENCE=forge-platform

FORGE_OTEL_SERVICE_NAME=forge-control-plane
FORGE_OTEL_OTLP_ENDPOINT=

FORGE_RATE_LIMIT_RPS=50
FORGE_RATE_LIMIT_BURST=100
